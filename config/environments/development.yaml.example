environment:
  name: "development"
  display_name: "Flutter Development"

app:
  name: "Flutter Business Dev"
  bundle_id: "com.example.flutter.development"
  version_name: "1.0.0"
  version_code: 1

network:
  api_base_url: "http://localhost:3000"
  websocket_url: "ws://localhost:3001"
  timeout: 30000

build:
  flavor: "development"
  build_type: "debug"
  obfuscate: false
  shrink_resources: false

signing:
  store_file: "debug.keystore"
  store_password_env: "DEBUG_STORE_PASSWORD"
  key_alias: "debug"
  key_password_env: "DEBUG_KEY_PASSWORD"

distribution:
  platform: "internal"
  track: "internal"

notifications:
  slack_webhook: "SLACK_WEBHOOK_URL_DEV"
  email_recipients: ["dev@example.com"]