{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["environment", "app", "network"],
  "properties": {
    "environment": {
      "type": "object",
      "required": ["name", "display_name"],
      "properties": {
        "name": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "display_name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "app": {
      "type": "object",
      "required": ["name", "bundle_id"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "bundle_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*(\\.[a-z0-9_]+)+[0-9a-z_]$"
        },
        "version_name": {
          "type": ["string", "null"],
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "version_code": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "network": {
      "type": "object",
      "required": ["api_base_url"],
      "properties": {
        "api_base_url": {
          "type": "string",
          "format": "uri"
        },
        "websocket_url": {
          "type": ["string", "null"],
          "format": "uri"
        },
        "timeout": {
          "type": "integer",
          "minimum": 1000
        }
      }
    },
    "build": {
      "type": ["object", "null"],
      "properties": {
        "flavor": {
          "type": "string",
          "enum": ["development", "staging", "production"]
        },
        "build_type": {
          "type": "string",
          "enum": ["debug", "release"]
        },
        "obfuscate": {
          "type": "boolean"
        },
        "shrink_resources": {
          "type": "boolean"
        }
      }
    },
    "signing": {
      "type": ["object", "null"],
      "properties": {
        "store_file": {
          "type": ["string", "null"]
        },
        "store_password_env": {
          "type": ["string", "null"]
        },
        "key_alias": {
          "type": ["string", "null"]
        },
        "key_password_env": {
          "type": ["string", "null"]
        }
      }
    },
    "distribution": {
      "type": ["object", "null"],
      "properties": {
        "platform": {
          "type": ["string", "null"]
        },
        "track": {
          "type": ["string", "null"]
        }
      }
    },
    "notifications": {
      "type": ["object", "null"],
      "properties": {
        "slack_webhook": {
          "type": ["string", "null"]
        },
        "email_recipients": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "email"
          }
        }
      }
    }
  }
}