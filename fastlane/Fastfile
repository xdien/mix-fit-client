# Shared lanes for common functionality
desc "Run all tests with comprehensive reporting"
lane :test do
  UI.message("🧪 Running all tests")
  
  begin
    # Run comprehensive test suite
    test_results = run_tests(
      run_unit_tests: true,
      run_widget_tests: true,
      run_integration_tests: true,
      generate_coverage: true,
      fail_build_on_test_failure: false, # Don't fail immediately for standalone test runs
      minimum_coverage: 70.0,
      fail_build_on_low_coverage: false
    )
    
    # Display detailed results
    UI.header("Test Execution Summary")
    
    total_passed = test_results[:unit_tests][:passed] + test_results[:widget_tests][:passed] + test_results[:integration_tests][:passed]
    total_failed = test_results[:unit_tests][:failed] + test_results[:widget_tests][:failed] + test_results[:integration_tests][:failed]
    
    if test_results[:success]
      UI.success("✅ All #{total_passed} tests passed!")
      UI.success("📊 Code coverage: #{test_results[:coverage_percentage].round(2)}%")
    else
      UI.important("⚠️  #{total_failed} test(s) failed out of #{total_passed + total_failed} total tests")
      UI.important("📊 Code coverage: #{test_results[:coverage_percentage].round(2)}%")
    end
    
    # Display report locations
    UI.message("📋 Test reports generated:")
    test_results[:reports].each do |report_type, path|
      UI.message("  - #{report_type}: #{path}") if File.exist?(path)
    end
    
    return test_results
    
  rescue => e
    UI.error("❌ Test execution failed: #{e.message}")
    raise e
  end
end

