# Helper functions
def handle_build_failure(exception, build_context)
  UI.error("Build failure in #{build_context}")
  UI.error("Exception: #{exception.message}")
  UI.error("Stack trace: #{exception.backtrace.join("\n")}")
  
  # Clean up build artifacts on failure
  begin
    UI.message("🧹 Cleaning up build artifacts after failure...")
    # Add cleanup logic here when implemented
  rescue => cleanup_error
    UI.error("Failed to clean up build artifacts: #{cleanup_error.message}")
  end
  
  # Log detailed error information to file
  begin
    error_log_dir = File.join(Dir.pwd, 'fastlane_logs')
    FileUtils.mkdir_p(error_log_dir)
    
    error_log_file = File.join(error_log_dir, "error_#{build_context}_#{Time.now.strftime('%Y%m%d_%H%M%S')}.log")
    
    error_details = {
      timestamp: Time.now.iso8601,
      build_context: build_context,
      exception_class: exception.class.name,
      exception_message: exception.message,
      stack_trace: exception.backtrace,
      environment: ENV.to_h.select { |k, v| k.start_with?('FLUTTER_', 'FASTLANE_', 'ANDROID_') }
    }
    
    File.write(error_log_file, JSON.pretty_generate(error_details))
    UI.message("📝 Error details logged to: #{error_log_file}")
    
  rescue => log_error
    UI.error("Failed to write error log: #{log_error.message}")
  end
end

def parse_test_failure_details(test_results)
  failure_details = []
  
  if test_results && test_results.is_a?(Hash)
    [:unit_tests, :widget_tests, :integration_tests].each do |test_type|
      if test_results[test_type] && test_results[test_type][:failed] > 0
        failure_details << "#{test_type.to_s.humanize}: #{test_results[test_type][:failed]} failed"
      end
    end
  end
  
  failure_details.empty? ? "Unknown test failures" : failure_details.join(", ")
end

# Error handling
error do |lane, exception|
  UI.error("❌ Lane #{lane} failed with exception: #{exception}")
  
  # Handle test-specific failures
  if exception.message.include?("Tests failed")
    UI.error("🧪 Test failures detected")
    
    # Try to get test results from lane context
    if Actions.lane_context[SharedValues::TEST_RESULTS]
      test_results = Actions.lane_context[SharedValues::TEST_RESULTS]
      failure_summary = parse_test_failure_details(test_results)
      UI.error("Test failure summary: #{failure_summary}")
    end
  end
  
  # Log error details
  handle_build_failure(exception, lane.to_s)
  
  # TODO: Send error notifications when notification system is implemented
end