{
  "environment": "production",
  "android": {
    "application_id": "com.iotecksolutions.todoapp",
    "keystore_path": "fastlane/keystores/production/production.keystore",
    "key_alias": "production_key",
    "build_type": "release",
    "store_password": "env:ANDROID_KEYSTORE_PASSWORD_PRODUCTION",
    "key_password": "env:ANDROID_KEY_PASSWORD_PRODUCTION"
  },
  "windows": {
    "app_name": "MixFit",
    "publisher": "IoTeck Solutions",
    "installer_type": "msi",
    "code_sign_certificate": "fastlane/keystores/production/windows_cert.p12",
    "code_sign_password": "env:WINDOWS_CERT_PASSWORD_PRODUCTION",
    "app_version": "1.0.0"
  },
  "linux": {
    "app_name": "MixFit",
    "desktop_entry": {
      "name": "MixFit",
      "comment": "Flutter Boilerplate Application",
      "categories": "Utility;Productivity;",
      "icon": "mixfit"
    },
    "appimage": {
      "icon": "assets/icons/ic_launcher.png",
      "update_info": "gh-releases-zsync|iotecksolutions|flutter-boilerplate|latest|*.AppImage.zsync",
      "app_id": "com.iotecksolutions.todoapp"
    }
  },
  "flutter": {
    "build_name": "1.0.0",
    "build_number": "manual",
    "flavor": "production",
    "dart_defines": {
      "ENVIRONMENT": "production",
      "API_BASE_URL": "https://api.iotecksolutions.com"
    }
  },
  "distribution": {
    "google_play_internal": false,
    "google_play_production": true,
    "github_releases": true,
    "auto_update": false,
    "firebase_app_distribution": false
  },
  "notifications": {
    "slack_webhook": "env:SLACK_WEBHOOK_PRODUCTION",
    "email_recipients": ["release-team@iotecksolutions.com"],
    "notify_on_success": true,
    "notify_on_failure": true
  }
}