# This file contains the fastlane.tools configuration
# You can find the documentation at https://docs.fastlane.tools
#
# For a list of all available actions, check out
#
#     https://docs.fastlane.tools/actions
#
# For a list of all available plugins, check out
#
#     https://docs.fastlane.tools/plugins/available-plugins
#

# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require_relative 'config_loader'
require_relative 'signing_manager'
require_relative 'certificate_validator'
require_relative 'credential_manager'
require_relative 'version_manager'

default_platform(:android)

platform :android do
  desc "Build and deploy Android app with environment configuration"
  lane :build do |options|
    environment = options[:env] || options[:environment] || "development"
    build_type = options[:build_type] || options[:type]
    upload = options[:upload] || false
    
    UI.header("🚀 Building #{environment} environment")
    
    begin
      # Load and validate environment configuration
      config = ConfigLoader.load_environment_config(environment)
      
      # Setup and validate signing credentials
      credential_manager = CredentialManager.new(environment)
      credential_manager.setup_secure_environment
      credential_manager.validate_environment_variables(config['signing'])
      credential_manager.audit_credential_access
      
      # Setup code signing
      signing_manager = SigningManager.new(config)
      signing_manager.setup_signing
      
      # Setup environment variables for Flutter
      ConfigLoader.setup_flutter_environment(config)
      
      # Build the Flutter app
      build_flutter_app(config, build_type)
      
      # Create build info
      build_info = ConfigLoader.create_build_info(config, build_type)
      
      # Copy and rename APK
      organize_build_artifacts(config, build_type)
      
      # Upload if requested
      if upload
        upload_app(config)
      end
      
      # Send notifications
      send_build_notifications(config, build_info, true)
      
      # Cleanup sensitive data
      credential_manager.cleanup_credentials
      
      UI.success("✅ Build completed successfully for #{environment} environment")
      
    rescue => e
      UI.error("❌ Build failed: #{e.message}")
      send_build_notifications(config, nil, false, e.message) if config
      
      # Cleanup sensitive data even on failure
      credential_manager.cleanup_credentials if credential_manager
      
      raise e
    end
  end
  
  desc "Build development version"
  lane :dev do |options|
    build(env: "development", build_type: "debug", upload: false)
  end
  
  desc "Build staging version"
  lane :staging do |options|
    upload = options[:upload] || false
    build(env: "staging", build_type: "release", upload: upload)
  end
  
  desc "Build production version"
  lane :prod do |options|
    upload = options[:upload] || false
    build(env: "production", build_type: "release", upload: upload)
  end
  
  desc "Run tests"
  lane :test do
    UI.header("🧪 Running tests")
    
    # Run Flutter tests
    Dir.chdir("../..") do
      sh("flutter test")
    end
    
    # Run Android tests
    gradle(task: "test")
    
    UI.success("✅ All tests passed")
  end
  
  desc "Clean build artifacts"
  lane :clean do
    UI.header("🧹 Cleaning build artifacts")
    
    # Clean Flutter build
    Dir.chdir("../..") do
      sh("flutter clean")
    end
    
    # Clean Android build
    gradle(task: "clean")
    
    UI.success("✅ Build artifacts cleaned")
  end
  
  desc "Validate environment configuration"
  lane :validate_config do |options|
    environment = options[:env] || "development"
    
    UI.header("🔍 Validating #{environment} configuration")
    
    config = ConfigLoader.load_environment_config(environment)
    UI.success("✅ Configuration is valid for #{environment} environment")
  end
  
  desc "Validate signing certificates"
  lane :validate_certificates do |options|
    environment = options[:env] || "development"
    
    UI.header("🔐 Validating signing certificates for #{environment}")
    
    config = ConfigLoader.load_environment_config(environment)
    
    # Setup credentials
    credential_manager = CredentialManager.new(environment)
    credential_manager.validate_environment_variables(config['signing'])
    
    # Validate certificate
    signing_manager = SigningManager.new(config)
    signing_manager.validate_certificate_availability
    
    # Detailed certificate validation
    keystore_path = signing_manager.get_keystore_path
    store_password = ENV[config['signing']['store_password_env']]
    key_alias = config['signing']['key_alias']
    
    validator = CertificateValidator.new(keystore_path, store_password, key_alias)
    cert_info = validator.validate_certificate
    validator.generate_certificate_report(cert_info)
    
    UI.success("✅ Certificate validation completed for #{environment}")
  end
  
  desc "Validate all environment certificates"
  lane :validate_all_certificates do
    CertificateValidator.validate_environment_certificates
  end
  
  desc "Setup signing credentials"
  lane :setup_credentials do |options|
    environment = options[:env] || "development"
    
    UI.header("🔧 Setting up signing credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    
    # Generate credentials template if it doesn't exist
    credentials_file = File.join(Dir.pwd, '..', 'credentials.yaml')
    unless File.exist?(credentials_file)
      template_path = credential_manager.generate_credentials_template
      UI.important("📝 Please copy #{template_path} to credentials.yaml and update with your passwords")
      UI.important("📝 Then run: fastlane load_credentials env:#{environment}")
      return
    end
    
    # Load credentials from file
    credential_manager.load_credentials_from_file(credentials_file)
    
    UI.success("✅ Credentials loaded for #{environment}")
  end
  
  desc "Load credentials from file"
  lane :load_credentials do |options|
    environment = options[:env] || "development"
    credentials_file = options[:file] || File.join(Dir.pwd, '..', 'credentials.yaml')
    
    UI.header("📂 Loading credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    credential_manager.load_credentials_from_file(credentials_file)
    
    UI.success("✅ Credentials loaded from #{credentials_file}")
  end
  
  desc "Generate debug keystore"
  lane :generate_debug_keystore do
    UI.header("🔨 Generating debug keystore")
    
    config = ConfigLoader.load_environment_config('development')
    signing_manager = SigningManager.new(config)
    
    keystore_path = signing_manager.create_debug_keystore
    
    UI.success("✅ Debug keystore created at #{keystore_path}")
  end
  
  desc "Audit signing access"
  lane :audit_signing do |options|
    environment = options[:env] || "development"
    
    UI.header("📊 Auditing signing access for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    audit_info = credential_manager.audit_credential_access
    
    UI.message("Audit information:")
    audit_info.each do |key, value|
      UI.message("  #{key}: #{value}")
    end
    
    UI.success("✅ Signing access audited")
  end
  
  # Private lanes
  
  private_lane :build_flutter_app do |config, build_type|
    UI.message("🔨 Building Flutter app...")
    
    # Change to Flutter project root
    Dir.chdir("../..") do
      # Get dependencies
      sh("flutter pub get")
      
      # Generate code if needed
      if File.exist?("pubspec.yaml") && File.read("pubspec.yaml").include?("build_runner")
        sh("flutter packages pub run build_runner build --delete-conflicting-outputs")
      end
      
      # Increment build number for release builds
      if build_type == 'release'
        UI.message("🔄 Incrementing build number for release build...")
        version_manager = VersionManager.new(config['environment']['name'], config)
        version_manager.increment_build_number
      end
      
      # Build the app
      build_command = ConfigLoader.get_build_command(config, build_type)
      UI.message("Executing: #{build_command}")
      sh(build_command)
    end
    
    UI.success("✅ Flutter app built successfully")
  end
  
  private_lane :organize_build_artifacts do |config, build_type|
    UI.message("📦 Organizing build artifacts...")
    
    environment = config['environment']['name']
    output_filename = ConfigLoader.get_output_filename(config, build_type)
    
    # Create environment-specific build directory
    build_dir = File.join(Dir.pwd, '..', '..', 'build', 'android', environment)
    FileUtils.mkdir_p(build_dir)
    
    # Find the built APK
    apk_path = File.join(Dir.pwd, '..', '..', 'build', 'app', 'outputs', 'flutter-apk', 'app-release.apk')
    if build_type == 'debug'
      apk_path = File.join(Dir.pwd, '..', '..', 'build', 'app', 'outputs', 'flutter-apk', 'app-debug.apk')
    end
    
    if File.exist?(apk_path)
      # Copy APK with environment-specific name
      target_path = File.join(build_dir, output_filename)
      FileUtils.cp(apk_path, target_path)
      UI.success("📱 APK copied to #{target_path}")
    else
      UI.error("❌ APK not found at #{apk_path}")
    end
    
    # Also check for AAB files
    aab_path = File.join(Dir.pwd, '..', '..', 'build', 'app', 'outputs', 'bundle', 'release', 'app-release.aab')
    if File.exist?(aab_path)
      aab_filename = output_filename.gsub('.apk', '.aab')
      target_aab_path = File.join(build_dir, aab_filename)
      FileUtils.cp(aab_path, target_aab_path)
      UI.success("📦 AAB copied to #{target_aab_path}")
    end
  end
  
  private_lane :upload_app do |config|
    UI.message("📤 Uploading app...")
    
    distribution_config = config['distribution']
    if distribution_config && distribution_config['platform'] == 'google_play'
      # This would require proper Google Play Console setup
      UI.message("🚀 Would upload to Google Play (#{distribution_config['track']} track)")
      # upload_to_play_store(track: distribution_config['track'])
    else
      UI.message("📋 Upload skipped - no distribution platform configured")
    end
  end
  
  private_lane :send_build_notifications do |config, build_info, success, error_message = nil|
    return unless config && config['notifications']
    
    notifications = config['notifications']
    environment = config['environment']['name']
    
    if success
      message = "✅ Build completed successfully for #{environment} environment"
      if build_info
        message += "\n📱 App: #{build_info[:app_name]}"
        message += "\n🔢 Version: #{build_info[:version_name]} (#{build_info[:version_code]})"
        message += "\n🏗️ Build Type: #{build_info[:build_type]}"
        message += "\n⏰ Build Time: #{build_info[:build_time]}"
      end
    else
      message = "❌ Build failed for #{environment} environment"
      message += "\n💥 Error: #{error_message}" if error_message
    end
    
    # Send Slack notification if configured
    if notifications['slack_webhook'] && ENV[notifications['slack_webhook']]
      begin
        slack(
          message: message,
          webhook_url: ENV[notifications['slack_webhook']],
          success: success
        )
        UI.success("📢 Slack notification sent")
      rescue => e
        UI.error("Failed to send Slack notification: #{e.message}")
      end
    end
    
    # Email notifications would be implemented here
    if notifications['email_recipients']
      UI.message("📧 Email notifications configured for: #{notifications['email_recipients'].join(', ')}")
    end
  end
  
  # Version Management Lanes
  
  desc "Increment build number"
  lane :increment_build do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_build_number
  end
  
  desc "Update version name"
  lane :update_version do |options|
    environment = options[:env] || options[:environment] || "development"
    version = options[:version]
    config = ConfigLoader.load_environment_config(environment)
    
    unless version
      UI.user_error!("Version parameter is required. Use: fastlane update_version version:1.2.3")
    end
    
    version_manager = VersionManager.new(environment, config)
    version_manager.update_version_name(version)
  end
  
  desc "Increment patch version"
  lane :increment_patch do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_patch
  end
  
  desc "Increment minor version"
  lane :increment_minor do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_minor
  end
  
  desc "Increment major version"
  lane :increment_major do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_major
  end
  
  desc "Create Git tag for current version"
  lane :create_tag do |options|
    environment = options[:env] || options[:environment] || "development"
    tag_message = options[:message]
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.create_tag(tag_message)
  end
  
  desc "Show current version information"
  lane :show_version do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.show_current_version
  end
  
  # Enhanced Security Lanes
  
  desc "Encrypt credentials file"
  lane :encrypt_credentials do |options|
    environment = options[:env] || "development"
    credentials_file = options[:file] || File.join(Dir.pwd, '..', 'credentials.yaml')
    output_file = options[:output] || File.join(Dir.pwd, '..', 'credentials.encrypted')
    encryption_key = options[:key]
    
    unless encryption_key
      UI.user_error!("Encryption key is required. Use: fastlane encrypt_credentials key:your-encryption-key")
    end
    
    UI.header("🔐 Encrypting credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    credential_manager.encrypt_credentials(credentials_file, output_file, encryption_key)
    
    UI.success("✅ Credentials encrypted successfully")
  end
  
  desc "Decrypt credentials file"
  lane :decrypt_credentials do |options|
    environment = options[:env] || "development"
    encrypted_file = options[:file] || File.join(Dir.pwd, '..', 'credentials.encrypted')
    encryption_key = options[:key]
    
    unless encryption_key
      UI.user_error!("Encryption key is required. Use: fastlane decrypt_credentials key:your-encryption-key")
    end
    
    UI.header("🔓 Decrypting credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    credential_manager.decrypt_credentials(encrypted_file, encryption_key)
    
    UI.success("✅ Credentials decrypted and loaded")
  end
  
  desc "Validate keystore integrity"
  lane :validate_keystore do |options|
    environment = options[:env] || "development"
    
    UI.header("🔍 Validating keystore integrity for #{environment}")
    
    config = ConfigLoader.load_environment_config(environment)
    credential_manager = CredentialManager.new(environment)
    
    # Load credentials
    credential_manager.validate_environment_variables(config['signing'])
    
    # Get keystore details
    signing_manager = SigningManager.new(config)
    keystore_path = signing_manager.get_keystore_path
    store_password = ENV[config['signing']['store_password_env']]
    
    # Validate integrity
    credential_manager.validate_keystore_integrity(keystore_path, store_password)
    
    UI.success("✅ Keystore integrity validation completed")
  end
  
  desc "Generate security report"
  lane :security_report do |options|
    environment = options[:env] || "development"
    
    UI.header("🛡️  Generating security report for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    report = credential_manager.generate_security_report
    
    UI.success("✅ Security report generated")
  end
  
  desc "Comprehensive certificate validation"
  lane :comprehensive_cert_validation do |options|
    environment = options[:env] || "development"
    
    UI.header("🔍 Comprehensive certificate validation for #{environment}")
    
    config = ConfigLoader.load_environment_config(environment)
    
    # Setup credentials
    credential_manager = CredentialManager.new(environment)
    credential_manager.validate_environment_variables(config['signing'])
    
    # Get certificate details
    signing_manager = SigningManager.new(config)
    keystore_path = signing_manager.get_keystore_path
    store_password = ENV[config['signing']['store_password_env']]
    key_alias = config['signing']['key_alias']
    
    # Run comprehensive validation
    validator = CertificateValidator.new(keystore_path, store_password, key_alias)
    cert_info = validator.comprehensive_validation
    
    UI.success("✅ Comprehensive certificate validation completed")
  end
  
  desc "Setup CI/CD credentials"
  lane :setup_ci_credentials do |options|
    environment = options[:env] || "development"
    
    UI.header("🔧 Setting up CI/CD credentials for #{environment}")
    
    CredentialManager.setup_ci_credentials(environment)
    
    UI.success("✅ CI/CD credentials setup completed")
  end
  
  desc "Security audit for signing process"
  lane :security_audit do |options|
    environment = options[:env] || "development"
    
    UI.header("🔍 Security audit for #{environment} signing process")
    
    begin
      # Load configuration
      config = ConfigLoader.load_environment_config(environment)
      
      # Initialize managers
      credential_manager = CredentialManager.new(environment)
      signing_manager = SigningManager.new(config)
      
      # Run security checks
      UI.message("1. Validating environment variables...")
      credential_manager.validate_environment_variables(config['signing'])
      
      UI.message("2. Checking credential exposure...")
      credential_manager.check_credential_exposure
      
      UI.message("3. Validating keystore integrity...")
      keystore_path = signing_manager.get_keystore_path
      store_password = ENV[config['signing']['store_password_env']]
      credential_manager.validate_keystore_integrity(keystore_path, store_password)
      
      UI.message("4. Validating certificate...")
      key_alias = config['signing']['key_alias']
      validator = CertificateValidator.new(keystore_path, store_password, key_alias)
      validator.comprehensive_validation
      
      UI.message("5. Generating security report...")
      credential_manager.generate_security_report
      
      UI.message("6. Auditing credential access...")
      credential_manager.audit_credential_access
      
      UI.success("✅ Security audit completed successfully")
      
    rescue => e
      UI.error("❌ Security audit failed: #{e.message}")
      raise e
    end
  end
  
  desc "Build with version increment and tag creation"
  lane :build_with_version do |options|
    environment = options[:env] || options[:environment] || "development"
    build_type = options[:build_type] || "release"
    create_tag = options[:create_tag] || false
    tag_message = options[:tag_message]
    
    UI.header("🚀 Building with version management for #{environment}")
    
    begin
      # Build the app (this will increment build number for release builds)
      build(env: environment, build_type: build_type, upload: false)
      
      # Create tag if requested
      if create_tag
        create_tag(message: tag_message)
      end
      
      UI.success("✅ Build with version management completed")
      
    rescue => e
      UI.error("❌ Build with version management failed: #{e.message}")
      raise e
    end
  end
end
