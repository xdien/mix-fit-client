    environment = options[:env] || options[:environment] || "development"
    
    DebugTools.generate_debug_package(environment)
  end
  
  desc "Build with enhanced error handling and recovery"
  lane :build_safe do |options|
    environment = options[:env] || options[:environment] || "development"
    build_type = options[:build_type] || options[:type] || "debug"
    upload = options[:upload] || false
    
    error_handler = ErrorHandler.new(environment, true) # Enable debug mode
    
    UI.header("🛡️  Safe build with enhanced error handling for #{environment}")
    
    begin
      # Pre-build diagnostics
      UI.message("🔍 Running pre-build diagnostics...")
      diagnosis = DebugTools.diagnose_environment(environment)
      
      if diagnosis[:issues].any?
        high_severity_issues = diagnosis[:issues].select { |issue| issue[:severity] == 'high' }
        
        if high_severity_issues.any?
          UI.error("❌ Found #{high_severity_issues.count} high-severity issues that must be resolved:")
          high_severity_issues.each do |issue|
            UI.error("   • #{issue[:message]}")
          end
          
          UI.user_error!("Please resolve high-severity issues before building")
        else
          UI.important("⚠️  Found #{diagnosis[:issues].count} issues, but continuing build...")
        end
      end
      
      # Run the build with error handling
      build(env: environment, build_type: build_type, upload: upload)
      
    rescue => e
      UI.error("❌ Safe build failed: #{e.message}")
      
      # Generate debug package on failure
      UI.message("📦 Generating debug package for troubleshooting...")
      debug_package = DebugTools.generate_debug_package(environment)
      
      UI.important("🔍 Debug package created at: #{debug_package[:package_dir]}")
      UI.important("📋 Please review the debug package for troubleshooting information")
      
      # Analyze the failure
      UI.message("🔍 Analyzing build failure...")
      DebugTools.analyze_build_failure
      
      raise e
    end
  end
  
  desc "Clean build with error recovery"
  lane :clean_build do |options|
    environment = options[:env] || options[:environment] || "development"
    build_type = options[:build_type] || options[:type] || "debug"
    
    error_handler = ErrorHandler.new(environment)
    
    UI.header("🧹 Clean build with error recovery for #{environment}")
    
    error_handler.with_error_handling(operation: 'clean_build') do
      # Clean everything
      UI.message("🧹 Cleaning build artifacts...")
      clean
      
      # Clean Flutter cache
      Dir.chdir("../..") do
        sh("flutter clean")
        sh("flutter pub get")
        
        # Clear build cache
        if Dir.exist?("build")
          FileUtils.rm_rf("build")
        end
        
        # Clear .dart_tool cache
        if Dir.exist?(".dart_tool")
          FileUtils.rm_rf(".dart_tool")
        end
      end
      
      # Clean Android cache
      Dir.chdir("..") do
        sh("./gradlew clean") if File.exist?("gradlew")
      end
      
      UI.success("✅ Clean completed successfully")
      
      # Run build
      UI.message("🚀 Starting fresh build...")
      build(env: environment, build_type: build_type, upload: false)
    end
  end
  
  desc "Validate and fix common configuration issues"
  lane :fix_config do |options|
    environment = options[:env] || options[:environment] || "development"
    
    UI.header("🔧 Validating and fixing configuration for #{environment}")
    
    error_handler = ErrorHandler.new(environment)
    
    begin
      # Check configuration integrity
      integrity = DebugTools.check_configuration_integrity(environment)
      
      if integrity[:issues].any?
        UI.message("🔧 Found configuration issues, attempting to fix...")
        
        integrity[:issues].each do |issue|
          case issue[:type]
          when 'missing_file'
            UI.message("📄 Creating missing configuration file...")
            # Create template configuration file
            create_config_template(environment)
          when 'missing_section'
            UI.message("📝 Configuration file exists but has missing sections")
            UI.important("Please manually add missing sections to the configuration file")
          when 'invalid_format'
            UI.message("⚠️  Invalid format detected in configuration")
            UI.important("Please manually fix format issues in the configuration file")
          end
        end
      else
        UI.success("✅ Configuration is valid")
      end
      
      # Check signing setup
      signing_test = DebugTools.test_signing_configuration(environment)
      
      if signing_test[:issues].any?
        UI.message("🔐 Found signing issues, attempting to fix...")
        
        signing_test[:issues].each do |issue|
          case issue[:type]
          when 'missing_keystore'
            if environment == 'development'
              UI.message("🔑 Generating debug keystore...")
              generate_debug_keystore
            else
              UI.important("Please provide keystore file for #{environment} environment")
            end
          when 'missing_env_vars'
            UI.important("Please set required environment variables for signing")
          end
        end
      else
        UI.success("✅ Signing configuration is valid")
      end
      
    rescue => e
      error_handler.handle_error(e, { operation: 'fix_config', environment: environment })
    end
  end
  
  desc "Show detailed build logs"
  lane :show_logs do |options|
    environment = options[:env] || options[:environment] || "development"
    lines = options[:lines] || 50
    
    log_dir = File.join(Dir.pwd, '..', '..', 'build', 'build_logs')
    
    if Dir.exist?(log_dir)
      log_files = Dir.glob(File.join(log_dir, "*#{environment}*.log")).sort_by { |f| File.mtime(f) }
      
      if log_files.any?
        latest_log = log_files.last
        UI.header("📋 Latest build log for #{environment} (#{File.basename(latest_log)})")
        
        content = File.readlines(latest_log).last(lines.to_i).join
        UI.message(content)
      else
        UI.message("No build logs found for #{environment}")
      end
    else
      UI.message("Build logs directory not found")
    end
  end
  
  desc "Enable debug mode for next build"
  lane :enable_debug do
    ENV['FASTLANE_DEBUG'] = 'true'
    UI.success("✅ Debug mode enabled for this session")
    UI.message("Run any build command to see detailed debug output")
  end
  
  desc "Disable debug mode"
  lane :disable_debug do
    ENV['FASTLANE_DEBUG'] = 'false'
    UI.success("✅ Debug mode disabled")
  end
  
  desc "Build with version increment and tag creation"
  lane :build_with_version do |options|
    environment = options[:env] || options[:environment] || "development"
    build_type = options[:build_type] || "release"
    create_tag = options[:create_tag] || false
    tag_message = options[:tag_message]
    
    UI.header("🚀 Building with version management for #{environment}")
    
    begin
      # Build the app (this will increment build number for release builds)
      build(env: environment, build_type: build_type, upload: false)
      
      # Create tag if requested
      if create_tag
        create_tag(message: tag_message)
      end
      
      UI.success("✅ Build with version management completed")
      
    rescue => e
      UI.error("❌ Build with version management failed: #{e.message}")
      raise e
    end
  end
  
  # Helper methods for error handling and debugging
  
  private_lane :create_config_template do |environment|
    config_dir = File.join(Dir.pwd, '..', '..', 'config', 'environments')
    FileUtils.mkdir_p(config_dir)
    
    config_file = File.join(config_dir, "#{environment}.yaml")
    
    template = <<~YAML
      # Configuration for #{environment} environment
      environment:
        name: "#{environment}"
        display_name: "CMS #{environment.capitalize}"
      
      app:
        name: "CMS Business"
        bundle_id: "com.placeholder.module.#{environment}"
        version_name: "1.0.0"
        version_code: 1
      
      network:
        api_base_url: "https://api-#{environment}.placeholder.com"
        websocket_url: "wss://ws-#{environment}.placeholder.com"
        timeout: 30000
      
      build:
        flavor: "#{environment}"
        build_type: "#{environment == 'development' ? 'debug' : 'release'}"
        obfuscate: #{environment == 'production'}
        shrink_resources: #{environment == 'production'}
      
      signing:
        store_file: "#{environment == 'development' ? 'debug.keystore' : environment + '.keystore'}"
        store_password_env: "STORE_PASSWORD_#{environment.upcase}"
        key_alias: "#{environment == 'development' ? 'androiddebugkey' : environment}"
        key_password_env: "KEY_PASSWORD_#{environment.upcase}"
      
      distribution:
        platform: "google_play"
        track: "#{environment == 'production' ? 'production' : 'internal'}"
      
      notifications:
        slack_webhook: "SLACK_WEBHOOK_URL"
        email_recipients: ["dev@placeholder.com"]
    YAML
    
    File.write(config_file, template)
    UI.success("✅ Created configuration template: #{config_file}")
    UI.important("📝 Please update the configuration with your actual values")
    
    config_file
  end
end
