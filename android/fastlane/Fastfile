# Uncomment the line if you want fastlane to automatically update itself
# update_fastlane

require_relative 'config_loader'
require_relative 'signing_manager'
require_relative 'certificate_validator'
require_relative 'credential_manager'
require_relative 'version_manager'
require_relative 'ci_environment_manager'
require_relative 'ci_artifact_manager'
require_relative 'error_handler'
require_relative 'build_logger'
require_relative 'debug_tools'

default_platform(:android)

platform :android do
  desc "Build and deploy Android app with environment configuration"
  lane :build do |options|
    environment = options[:env] || options[:environment] || "development"
    build_type = options[:build_type] || options[:type]
    upload = options[:upload] || false
    
    # Initialize error handler and build logger
    error_handler = ErrorHandler.new(environment, ENV['FASTLANE_DEBUG'] == 'true')
    build_logger = BuildLogger.new(environment, build_type)
    
    error_handler.with_error_handling(operation: 'build', environment: environment) do
      # Load and validate environment configuration
      config = error_handler.with_error_handling(operation: 'config_loading') do
        config_path = File.join(Dir.pwd, '..', '..', 'config', 'environments', "#{environment}.yaml")
        
        # Enhanced configuration validation
        unless File.exist?(config_path)
          raise ConfigValidationError.new("Configuration file not found: #{config_path}")
        end
        
        config = YAML.load_file(config_path)
        error_handler.validate_configuration(config, config_path)
        
        build_logger.log_config_loading(config_path, config)
        config
      end
      
      # Start build logging
      build_logger.start_build(config)
      
      begin
        # Setup CI environment if running in CI
        if ENV['CI'] == 'true'
          build_logger.execute_step('CI Environment Setup', 'Setting up CI/CD environment') do
            CIEnvironmentManager.setup_ci_environment(environment)
          end
        end
        
        # Setup and validate signing credentials
        credential_manager = build_logger.execute_step('Credential Setup', 'Setting up signing credentials') do
          manager = CredentialManager.new(environment)
          manager.setup_secure_environment
          manager.validate_environment_variables(config['signing'])
          manager.audit_credential_access
          
          build_logger.log_signing_setup(
            File.join(Dir.pwd, '..', 'keystores', config['signing']['store_file']),
            config['signing']['key_alias']
          )
          
          manager
        end
        
        # Setup code signing
        signing_manager = build_logger.execute_step('Code Signing Setup', 'Configuring code signing') do
          manager = SigningManager.new(config)
          manager.setup_signing
          manager
        end
        
        # Setup environment variables for Flutter
        build_logger.execute_step('Environment Configuration', 'Setting up Flutter environment variables') do
          ConfigLoader.setup_flutter_environment(config)
          
          # Log environment setup (without sensitive values)
          env_vars = {
            'API_BASE_URL' => ENV['API_BASE_URL'],
            'WEBSOCKET_URL' => ENV['WEBSOCKET_URL'],
            'APP_NAME' => ENV['APP_NAME'],
            'BUNDLE_ID' => ENV['BUNDLE_ID'],
            'ENVIRONMENT' => ENV['ENVIRONMENT'],
            'BUILD_FLAVOR' => ENV['BUILD_FLAVOR'],
            'BUILD_TYPE' => ENV['BUILD_TYPE']
          }.compact
          
          build_logger.log_environment_setup(env_vars)
        end
        
        # Build the Flutter app
        build_logger.execute_step('Flutter Build', 'Building Flutter application') do
          build_flutter_app_with_logging(config, build_type, build_logger)
        end
        
        # Create build info
        build_info = build_logger.execute_step('Build Info Generation', 'Creating build metadata') do
          ConfigLoader.create_build_info(config, build_type)
        end
        
        # Organize build artifacts (CI-aware)
        artifact_info = build_logger.execute_step('Artifact Organization', 'Organizing build artifacts') do
          if ENV['CI'] == 'true'
            CIArtifactManager.organize_ci_artifacts(environment, build_type)
          else
            ConfigLoader.organize_build_artifacts(config, build_type)
          end
        end
        
        # Log artifact generation
        if artifact_info && artifact_info[:metadata] && artifact_info[:metadata][:artifacts]
          artifacts = []
          
          artifact_info[:metadata][:artifacts][:apk_files].each do |apk|
            artifacts << { type: 'APK', path: apk[:path] }
          end
          
          artifact_info[:metadata][:artifacts][:aab_files].each do |aab|
            artifacts << { type: 'AAB', path: aab[:path] }
          end
          
          build_logger.log_artifact_generation(artifacts) if artifacts.any?
        end
        
        # Upload if requested
        if upload
          build_logger.execute_step('App Upload', 'Uploading to distribution platform') do
            upload_app(config)
          end
        end
        
        # Send notifications with artifact info
        build_logger.execute_step('Notifications', 'Sending build notifications') do
          send_build_notifications(config, build_info, true, nil, artifact_info)
        end
        
        # Generate CI report if in CI environment
        if ENV['CI'] == 'true'
          build_logger.execute_step('CI Report Generation', 'Generating CI/CD reports') do
            CIEnvironmentManager.generate_ci_report(environment)
          end
        end
        
        # Log performance metrics
        build_result = build_logger.end_build(true)
        if build_result[:performance_metrics]
          build_logger.log_performance_metrics(build_result[:performance_metrics])
        end
        
        error_handler.log_info("Build completed successfully", {
          environment: environment,
          build_type: build_type,
          duration: build_result[:duration_seconds],
          build_id: build_logger.build_id
        })
        
      rescue => build_error
        # Log build failure
        build_logger.end_build(false, build_error)
        
        # Send failure notifications
        send_build_notifications(config, nil, false, build_error.message) if config
        
        # Generate debug information on failure
        error_handler.generate_debug_info({
          operation: 'build',
          environment: environment,
          build_type: build_type,
          error_class: build_error.class.name,
          error_message: build_error.message
        })
        
        raise build_error
        
      ensure
        # Cleanup sensitive data
        if credential_manager
          build_logger.execute_step('Credential Cleanup', 'Cleaning up sensitive data') do
            credential_manager.cleanup_credentials
          end
        end
        
        # Cleanup CI environment if needed
        if ENV['CI'] == 'true'
          build_logger.execute_step('CI Cleanup', 'Cleaning up CI environment') do
            CIEnvironmentManager.cleanup_ci_environment
          end
        end
      end
    end
  end
  
  desc "Build development version"
  lane :dev do |options|
    build(env: "development", build_type: "debug", upload: false)
  end
  
  desc "Build staging version"
  lane :staging do |options|
    upload = options[:upload] || false
    build(env: "staging", build_type: "release", upload: upload)
  end
  
  desc "Build production version"
  lane :prod do |options|
    upload = options[:upload] || false
    build(env: "production", build_type: "release", upload: upload)
  end
  
  desc "Run tests"
  lane :test do
    UI.header("🧪 Running tests")
    
    # Run Flutter tests
    Dir.chdir("../..") do
      sh("flutter test")
    end
    
    # Run Android tests
    gradle(task: "test")
    
    UI.success("✅ All tests passed")
  end
  
  desc "Clean build artifacts"
  lane :clean do
    UI.header("🧹 Cleaning build artifacts")
    
    # Clean Flutter build
    Dir.chdir("../..") do
      sh("flutter clean")
    end
    
    # Clean Android build
    gradle(task: "clean")
    
    UI.success("✅ Build artifacts cleaned")
  end
  
  desc "Validate environment configuration"
  lane :validate_config do |options|
    environment = options[:env] || "development"
    
    UI.header("🔍 Validating #{environment} configuration")
    
    config = ConfigLoader.load_environment_config(environment)
    UI.success("✅ Configuration is valid for #{environment} environment")
  end
  
  desc "Validate signing certificates"
  lane :validate_certificates do |options|
    environment = options[:env] || "development"
    
    UI.header("🔐 Validating signing certificates for #{environment}")
    
    config = ConfigLoader.load_environment_config(environment)
    
    # Setup credentials
    credential_manager = CredentialManager.new(environment)
    credential_manager.validate_environment_variables(config['signing'])
    
    # Validate certificate
    signing_manager = SigningManager.new(config)
    signing_manager.validate_certificate_availability
    
    # Detailed certificate validation
    keystore_path = signing_manager.get_keystore_path
    store_password = ENV[config['signing']['store_password_env']]
    key_alias = config['signing']['key_alias']
    
    validator = CertificateValidator.new(keystore_path, store_password, key_alias)
    cert_info = validator.validate_certificate
    validator.generate_certificate_report(cert_info)
    
    UI.success("✅ Certificate validation completed for #{environment}")
  end
  
  desc "Validate all environment certificates"
  lane :validate_all_certificates do
    CertificateValidator.validate_environment_certificates
  end
  
  desc "Setup signing credentials"
  lane :setup_credentials do |options|
    environment = options[:env] || "development"
    
    UI.header("🔧 Setting up signing credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    
    # Generate credentials template if it doesn't exist
    credentials_file = File.join(Dir.pwd, '..', 'credentials.yaml')
    unless File.exist?(credentials_file)
      template_path = credential_manager.generate_credentials_template
      UI.important("📝 Please copy #{template_path} to credentials.yaml and update with your passwords")
      UI.important("📝 Then run: fastlane load_credentials env:#{environment}")
      return
    end
    
    # Load credentials from file
    credential_manager.load_credentials_from_file(credentials_file)
    
    UI.success("✅ Credentials loaded for #{environment}")
  end
  
  desc "Load credentials from file"
  lane :load_credentials do |options|
    environment = options[:env] || "development"
    credentials_file = options[:file] || File.join(Dir.pwd, '..', 'credentials.yaml')
    
    UI.header("📂 Loading credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    credential_manager.load_credentials_from_file(credentials_file)
    
    UI.success("✅ Credentials loaded from #{credentials_file}")
  end
  
  desc "Generate debug keystore"
  lane :generate_debug_keystore do
    UI.header("🔨 Generating debug keystore")
    
    config = ConfigLoader.load_environment_config('development')
    signing_manager = SigningManager.new(config)
    
    keystore_path = signing_manager.create_debug_keystore
    
    UI.success("✅ Debug keystore created at #{keystore_path}")
  end
  
  desc "Audit signing access"
  lane :audit_signing do |options|
    environment = options[:env] || "development"
    
    UI.header("📊 Auditing signing access for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    audit_info = credential_manager.audit_credential_access
    
    UI.message("Audit information:")
    audit_info.each do |key, value|
      UI.message("  #{key}: #{value}")
    end
    
    UI.success("✅ Signing access audited")
  end
  
  # Private lanes
  
  private_lane :build_flutter_app do |config, build_type|
    UI.message("🔨 Building Flutter app...")
    
    # Change to Flutter project root
    Dir.chdir("../..") do
      # Get dependencies
      sh("flutter pub get")
      
      # Generate code if needed
      if File.exist?("pubspec.yaml") && File.read("pubspec.yaml").include?("build_runner")
        sh("flutter packages pub run build_runner build --delete-conflicting-outputs")
      end
      
      # Increment build number for release builds
      if build_type == 'release'
        UI.message("🔄 Incrementing build number for release build...")
        version_manager = VersionManager.new(config['environment']['name'], config)
        version_manager.increment_build_number
      end
      
      # Build the app
      build_command = ConfigLoader.get_build_command(config, build_type)
      UI.message("Executing: #{build_command}")
      sh(build_command)
    end
    
    UI.success("✅ Flutter app built successfully")
  end
  
  private_lane :build_flutter_app_with_logging do |config, build_type, build_logger|
    # Change to Flutter project root
    Dir.chdir("../..") do
      # Get dependencies
      build_logger.execute_step('Dependencies', 'Installing Flutter dependencies') do
        command = "flutter pub get"
        build_logger.log_flutter_command(command, Dir.pwd)
        
        output = `#{command} 2>&1`
        exit_status = $?.exitstatus
        
        build_logger.log_command_output(command, output, exit_status)
        
        if exit_status != 0
          raise BuildError.new("Failed to get Flutter dependencies: #{output}")
        end
        
        { dependencies_installed: true }
      end
      
      # Generate code if needed
      if File.exist?("pubspec.yaml") && File.read("pubspec.yaml").include?("build_runner")
        build_logger.execute_step('Code Generation', 'Running build_runner for code generation') do
          command = "flutter packages pub run build_runner build --delete-conflicting-outputs"
          build_logger.log_flutter_command(command, Dir.pwd)
          
          output = `#{command} 2>&1`
          exit_status = $?.exitstatus
          
          build_logger.log_command_output(command, output, exit_status)
          
          if exit_status != 0
            build_logger.log_warning("Code generation failed, continuing build", { 
              command: command, 
              output: output 
            })
          end
          
          { code_generation_completed: true }
        end
      end
      
      # Increment build number for release builds
      if build_type == 'release'
        build_logger.execute_step('Version Management', 'Incrementing build number for release') do
          version_manager = VersionManager.new(config['environment']['name'], config)
          old_version = version_manager.get_current_version_info
          
          version_manager.increment_build_number
          
          new_version = version_manager.get_current_version_info
          build_logger.log_version_update(
            "#{old_version[:version_name]} (#{old_version[:version_code]})",
            "#{new_version[:version_name]} (#{new_version[:version_code]})",
            'build_number'
          )
          
          { 
            old_version: old_version,
            new_version: new_version
          }
        end
      end
      
      # Build the app
      build_logger.execute_step('Flutter Compilation', 'Compiling Flutter application') do
        build_command = ConfigLoader.get_build_command(config, build_type)
        build_logger.log_flutter_command(build_command, Dir.pwd)
        
        # Execute with real-time output capture
        output_lines = []
        exit_status = nil
        
        Open3.popen2e(build_command) do |stdin, stdout_err, wait_thr|
          stdout_err.each_line do |line|
            output_lines << line
            # Log important build progress in real-time
            if line.include?('Building') || line.include?('Compiling') || line.include?('Linking')
              build_logger.log_debug("Build progress: #{line.strip}")
            end
          end
          exit_status = wait_thr.value.exitstatus
        end
        
        full_output = output_lines.join
        build_logger.log_command_output(build_command, full_output, exit_status)
        
        if exit_status != 0
          # Analyze build failure
          if full_output.include?('Gradle')
            raise BuildError.new("Gradle build failed. Check Android configuration and dependencies.")
          elsif full_output.include?('Flutter')
            raise BuildError.new("Flutter compilation failed. Check Dart code and dependencies.")
          else
            raise BuildError.new("Build failed with exit status #{exit_status}: #{full_output}")
          end
        end
        
        # Check if APK/AAB files were generated
        build_dir = File.join(Dir.pwd, 'build', 'app', 'outputs')
        apk_files = Dir.glob(File.join(build_dir, '**', '*.apk'))
        aab_files = Dir.glob(File.join(build_dir, '**', '*.aab'))
        
        {
          build_command: build_command,
          exit_status: exit_status,
          apk_files_generated: apk_files.count,
          aab_files_generated: aab_files.count,
          output_directory: build_dir
        }
      end
    end
  end
  

  
  private_lane :upload_app do |config|
    UI.message("📤 Uploading app...")
    
    distribution_config = config['distribution']
    if distribution_config && distribution_config['platform'] == 'google_play'
      # This would require proper Google Play Console setup
      UI.message("🚀 Would upload to Google Play (#{distribution_config['track']} track)")
      # upload_to_play_store(track: distribution_config['track'])
    else
      UI.message("📋 Upload skipped - no distribution platform configured")
    end
  end
  
  private_lane :send_build_notifications do |config, build_info, success, error_message = nil, artifact_info = nil|
    return unless config && config['notifications']
    
    notifications = config['notifications']
    environment = config['environment']['name']
    
    if success
      message = "✅ Build completed successfully for #{environment} environment"
      if build_info
        message += "\n📱 App: #{build_info[:app_name]}"
        message += "\n🔢 Version: #{build_info[:version_name]} (#{build_info[:version_code]})"
        message += "\n🏗️ Build Type: #{build_info[:build_type]}"
        message += "\n⏰ Build Time: #{build_info[:build_time]}"
      end
      
      # Add artifact information if available
      if artifact_info && artifact_info[:metadata]
        artifacts = artifact_info[:metadata][:artifacts]
        if artifacts[:apk_files].any?
          message += "\n\n📦 APK Files:"
          artifacts[:apk_files].each do |apk|
            message += "\n  • #{apk[:filename]} (#{apk[:size_human]})"
          end
        end
        if artifacts[:aab_files].any?
          message += "\n\n📦 AAB Files:"
          artifacts[:aab_files].each do |aab|
            message += "\n  • #{aab[:filename]} (#{aab[:size_human]})"
          end
        end
        
        # Add build directory info
        if artifact_info[:build_directory]
          relative_path = artifact_info[:build_directory].gsub(Dir.pwd + '/../..', '.')
          message += "\n\n📁 Build Directory: #{relative_path}"
        end
      end
    else
      message = "❌ Build failed for #{environment} environment"
      message += "\n💥 Error: #{error_message}" if error_message
    end
    
    # Send Slack notification if configured
    if notifications['slack_webhook'] && ENV[notifications['slack_webhook']]
      begin
        slack(
          message: message,
          webhook_url: ENV[notifications['slack_webhook']],
          success: success
        )
        UI.success("📢 Slack notification sent")
      rescue => e
        UI.error("Failed to send Slack notification: #{e.message}")
      end
    end
    
    # Email notifications would be implemented here
    if notifications['email_recipients']
      UI.message("📧 Email notifications configured for: #{notifications['email_recipients'].join(', ')}")
    end
  end
  
  # Version Management Lanes
  
  desc "Increment build number"
  lane :increment_build do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_build_number
  end
  
  desc "Update version name"
  lane :update_version do |options|
    environment = options[:env] || options[:environment] || "development"
    version = options[:version]
    config = ConfigLoader.load_environment_config(environment)
    
    unless version
      UI.user_error!("Version parameter is required. Use: fastlane update_version version:1.2.3")
    end
    
    version_manager = VersionManager.new(environment, config)
    version_manager.update_version_name(version)
  end
  
  desc "Increment patch version"
  lane :increment_patch do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_patch
  end
  
  desc "Increment minor version"
  lane :increment_minor do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_minor
  end
  
  desc "Increment major version"
  lane :increment_major do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.increment_major
  end
  
  desc "Create Git tag for current version"
  lane :create_tag do |options|
    environment = options[:env] || options[:environment] || "development"
    tag_message = options[:message]
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.create_tag(tag_message)
  end
  
  desc "Show current version information"
  lane :show_version do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.show_current_version
  end
  
  desc "Show version history"
  lane :version_history do |options|
    environment = options[:env] || options[:environment] || "development"
    limit = options[:limit] || 10
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.show_version_history(limit)
  end
  
  desc "Show version statistics"
  lane :version_stats do |options|
    environment = options[:env] || options[:environment] || "development"
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.show_version_statistics
  end
  
  desc "Generate changelog from version history"
  lane :generate_changelog do |options|
    environment = options[:env] || options[:environment] || "development"
    since_version = options[:since]
    output_file = options[:output]
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.generate_changelog(since_version, output_file)
  end
  
  desc "Export version history"
  lane :export_version_history do |options|
    environment = options[:env] || options[:environment] || "development"
    format = options[:format] || "json"
    output_file = options[:output]
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.export_version_history(format, output_file)
  end
  
  desc "Clean up old version history"
  lane :cleanup_version_history do |options|
    environment = options[:env] || options[:environment] || "development"
    keep_days = options[:keep_days] || 90
    config = ConfigLoader.load_environment_config(environment)
    
    version_manager = VersionManager.new(environment, config)
    version_manager.cleanup_version_history(keep_days)
  end
  
  # Enhanced Security Lanes
  
  desc "Encrypt credentials file"
  lane :encrypt_credentials do |options|
    environment = options[:env] || "development"
    credentials_file = options[:file] || File.join(Dir.pwd, '..', 'credentials.yaml')
    output_file = options[:output] || File.join(Dir.pwd, '..', 'credentials.encrypted')
    encryption_key = options[:key]
    
    unless encryption_key
      UI.user_error!("Encryption key is required. Use: fastlane encrypt_credentials key:your-encryption-key")
    end
    
    UI.header("🔐 Encrypting credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    credential_manager.encrypt_credentials(credentials_file, output_file, encryption_key)
    
    UI.success("✅ Credentials encrypted successfully")
  end
  
  desc "Decrypt credentials file"
  lane :decrypt_credentials do |options|
    environment = options[:env] || "development"
    encrypted_file = options[:file] || File.join(Dir.pwd, '..', 'credentials.encrypted')
    encryption_key = options[:key]
    
    unless encryption_key
      UI.user_error!("Encryption key is required. Use: fastlane decrypt_credentials key:your-encryption-key")
    end
    
    UI.header("🔓 Decrypting credentials for #{environment}")
    
    credential_manager = CredentialManager.new(environment)
    credential_manager.decrypt_credentials(encrypted_file, encryption_key)
    
    UI.success("✅ Credentials decrypted and loaded")
  end
  
  desc "Validate keystore integrity"
  lane :validate_keystore do |options|
    environment = options[:env] || "development"
    
    UI.header("🔍 Validating keystore integrity for #{environment}")
    
    config = ConfigLoader.load_environment_config(environment)
    credential_manager = CredentialManager.new(environment)
    
    # Load credentials
    credential_manager.validate_environment_variables(config['signing'])
    
    # Get keystore details
    signing_manager = SigningManager.new(config)
    keystore_path = signing_manager.get_keystore_path
    store_password = ENV[config['signing']['store_password_env']]
    
    # Validate integrity
    credential_manager.validate_keystore_integrity(keystore_path, store_password)
    
    UI.success("✅ Keystore integrity validation completed")
  end
  
  desc "Generate security report"
