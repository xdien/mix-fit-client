    environment = options[:env] || "development"
    build_type = options[:build_type] || "release"
    upload = options[:upload] || false
    
    UI.header("🤖 CI/CD Build Pipeline for #{environment}")
    
    begin
      # Setup CI environment
      CIEnvironmentManager.setup_ci_environment(environment)
      
      # Validate CI secrets
      CIEnvironmentManager.validate_secrets(environment)
      
      # Run the build
      build(env: environment, build_type: build_type, upload: upload)
      
      # Validate artifacts
      CIArtifactManager.validate_ci_artifacts(environment)
      
      # Generate reports
      CIEnvironmentManager.generate_ci_report(environment)
      CIArtifactManager.generate_ci_artifact_report(environment)
      
      UI.success("✅ CI/CD build pipeline completed successfully")
      
    rescue => e
      UI.error("❌ CI/CD build pipeline failed: #{e.message}")
      
      # Cleanup on failure
      CIEnvironmentManager.cleanup_ci_environment
      
      raise e
    end
  end
  
  desc "Validate CI artifacts"
