  desc "Show latest build information"
  lane :latest_build do |options|
    environment = options[:env] || options[:environment] || "development"
    
    UI.header("📋 Latest build info for #{environment}")
    
    build_info = ArtifactManager.get_latest_build_info(environment)
    if build_info
      UI.message("📱 App: #{build_info['app_name']}")
      UI.message("🔢 Version: #{build_info['version_name']} (#{build_info['version_code']})")
      UI.message("🏗️ Build Type: #{build_info['build_type']}")
      UI.message("⏰ Build Time: #{build_info['build_time']}")
      UI.message("🌐 API URL: #{build_info['api_base_url']}")
    else
      UI.message("No build information found for #{environment}")
    end
  end
  
  desc "Clean up old build artifacts"
  lane :cleanup_builds do |options|
    environment = options[:env] || options[:environment] || "development"
    keep_days = options[:keep_days] || 30
    
    ArtifactManager.cleanup_old_builds(environment, keep_days)
  end
  
  desc "Validate build artifacts"
  lane :validate_artifacts do |options|
    environment = options[:env] || options[:environment] || "development"
    
    UI.header("🔍 Validating artifacts for #{environment}")
    
    latest_dir = File.join(Dir.pwd, '..', '..', 'build', 'android', environment, 'latest')
    unless File.exist?(latest_dir)
      UI.error("No builds found for #{environment}")
      return
    end
    
    # Read metadata and validate
    metadata_path = File.join(latest_dir, 'metadata', 'build-info.json')
    unless File.exist?(metadata_path)
      UI.error("Build metadata not found")
      return
    end
    
    begin
      metadata = JSON.parse(File.read(metadata_path))
      
      # Create temporary artifact manager for validation
      config = ConfigLoader.load_environment_config(environment)
      artifact_manager = ArtifactManager.new(config, metadata['build_info']['build_type'])
      artifact_manager.send(:validate_artifacts, latest_dir, metadata.transform_keys(&:to_sym))
      
      UI.success("✅ All artifacts are valid")
    rescue => e
      UI.error("❌ Artifact validation failed: #{e.message}")
      raise e
    end
  end
  
  desc "Generate artifact report"
  lane :artifact_report do |options|
    environment = options[:env] || options[:environment] || "development"
    format = options[:format] || "text"
    
    UI.header("📊 Generating artifact report for #{environment}")
    
    base_dir = File.join(Dir.pwd, '..', '..', 'build', 'android', environment)
    unless Dir.exist?(base_dir)
      UI.message("No builds found for #{environment}")
      return
    end
    
    builds = Dir.glob(File.join(base_dir, '*'))
                .select { |path| File.directory?(path) && File.basename(path) != 'latest' }
                .sort_by { |path| File.basename(path) }
                .reverse
    
    if format == "json"
      report = {
        environment: environment,
        total_builds: builds.count,
        builds: []
      }
      
      builds.each do |build_dir|
        build_info_path = File.join(build_dir, 'build-info.json')
        if File.exist?(build_info_path)
          build_info = JSON.parse(File.read(build_info_path))
          report[:builds] << build_info
        end
      end
      
      report_path = File.join(base_dir, "artifact-report-#{Time.now.strftime('%Y%m%d-%H%M%S')}.json")
      File.write(report_path, JSON.pretty_generate(report))
      UI.success("📄 JSON report saved to #{report_path}")
    else
      # Text format
      UI.message("Environment: #{environment}")
      UI.message("Total builds: #{builds.count}")
      UI.message("")
      
      builds.take(20).each do |build_dir|
        dir_name = File.basename(build_dir)
        build_info_path = File.join(build_dir, 'build-info.json')
        
        if File.exist?(build_info_path)
          build_info = JSON.parse(File.read(build_info_path))
          UI.message("#{dir_name}: v#{build_info['version_name']} (#{build_info['build_type']})")
        else
          UI.message("#{dir_name}: (no info)")
        end
      end
    end
  end
  
  desc "Security audit for signing process"
  lane :security_audit do |options|
    environment = options[:env] || "development"
    
    UI.header("🔍 Security audit for #{environment} signing process")
    
    begin
      # Load configuration
      config = ConfigLoader.load_environment_config(environment)
      
      # Initialize managers
      credential_manager = CredentialManager.new(environment)
      signing_manager = SigningManager.new(config)
      
      # Run security checks
      UI.message("1. Validating environment variables...")
      credential_manager.validate_environment_variables(config['signing'])
      
      UI.message("2. Checking credential exposure...")
      credential_manager.check_credential_exposure
      
      UI.message("3. Validating keystore integrity...")
      keystore_path = signing_manager.get_keystore_path
      store_password = ENV[config['signing']['store_password_env']]
      credential_manager.validate_keystore_integrity(keystore_path, store_password)
      
      UI.message("4. Validating certificate...")
      key_alias = config['signing']['key_alias']
      validator = CertificateValidator.new(keystore_path, store_password, key_alias)
      validator.comprehensive_validation
      
      UI.message("5. Generating security report...")
      credential_manager.generate_security_report
      
      UI.message("6. Auditing credential access...")
      credential_manager.audit_credential_access
      
      UI.success("✅ Security audit completed successfully")
      
    rescue => e
      UI.error("❌ Security audit failed: #{e.message}")
      raise e
    end
  end
  
  # Error Handling and Debugging Lanes
  
  desc "Diagnose environment configuration and setup"
